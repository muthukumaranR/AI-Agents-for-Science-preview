---
import { getCollection } from 'astro:content';
import AkdRefLink from './AkdRefLink.astro';

const items = (await getCollection('governance'))
  .sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));
---
{items.length > 0 && (
  <section class="section" id="governance">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">04 · Governance</span>
        <h2>Process &amp; governance deliverables.</h2>
      </div>
      <div class="governance-grid">
        {items.map((item) => (
          <article class="card governance-card">
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            {item.data.akdRef && (
              <AkdRefLink kind={item.data.akdRef.kind} path={item.data.akdRef.path} />
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .governance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .governance-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .governance-card h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    margin: 0;
  }
  .governance-card p { font-size: 14px; margin: 0; flex: 1; }

  @media (max-width: 1024px) {
    .governance-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .governance-grid { grid-template-columns: 1fr; }
  }
</style>
