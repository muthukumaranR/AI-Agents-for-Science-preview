<section class="section" id="github">
  <div class="container">
    <div class="gh-section">
      <span class="eyebrow" style="justify-content:center;">13 · GitHub &amp; Documentation</span>
      <h2>Open. Auditable. Built in public.</h2>
      <p>
        Explore the AI Agents for Science repository, contribute agents, review
        documentation, and help build open, trustworthy AI infrastructure for science.
      </p>

      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:8px;">
        <a class="btn btn-primary" href="https://github.com/NASA-IMPACT/AI-Agents-for-Science" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="14" height="14"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          Main Repository
        </a>
        <a class="btn btn-ghost" href="https://ntrs.nasa.gov/citations/20260000926" target="_blank" rel="noopener">📄 CARE Paper (NTRS)</a>
      </div>

      <div class="gh-grid">
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/AI-Agents-for-Science" target="_blank" rel="noopener">
          <div class="glyph">★</div>
          <div><b>AI Agents for Science</b><span>NASA-IMPACT/AI-Agents-for-Science</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/AKD-CARE" target="_blank" rel="noopener">
          <div class="glyph">◇</div>
          <div><b>CARE</b><span>NASA-IMPACT/AKD-CARE</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd-core" target="_blank" rel="noopener">
          <div class="glyph">◆</div>
          <div><b>AKD Core</b><span>NASA-IMPACT/akd-core</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd-ext" target="_blank" rel="noopener">
          <div class="glyph">◇</div>
          <div><b>AKD Ext</b><span>NASA-IMPACT/akd-ext</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd/tree/main/guardrails" target="_blank" rel="noopener">
          <div class="glyph">⛨</div>
          <div><b>Guardrails</b><span>NASA-IMPACT/akd · guardrails</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd-labs" target="_blank" rel="noopener">
          <div class="glyph">⚗</div>
          <div><b>AKD Labs</b><span>NASA-IMPACT/akd-labs</span></div>
        </a>
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd/tree/main/flow" target="_blank" rel="noopener">
          <div class="glyph">⌘</div>
          <div><b>AKD Flow</b><span>NASA-IMPACT/akd · flow</span></div>
        </a>
        {/* HEADS UP: this akd-suite path is also referenced in
            src/content/workflows/closed-loop-cm1.mdx. Keep them in sync. */}
        <a class="gh-tile" href="https://github.com/NASA-IMPACT/akd-suite/tree/main/agents/closed-loop-cm1" target="_blank" rel="noopener">
          <div class="glyph">◎</div>
          <div><b>Closed-Loop CM1</b><span>akd-suite/agents/closed-loop-cm1</span></div>
        </a>
        <a class="gh-tile" href="https://ntrs.nasa.gov/citations/20260000926" target="_blank" rel="noopener">
          <div class="glyph">📄</div>
          <div><b>CARE Paper</b><span>ntrs.nasa.gov / 20260000926</span></div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .gh-section {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 56px 48px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    text-align: center;
  }
  .gh-section h2 { margin-bottom: 14px; }
  .gh-section p { max-width: 640px; margin: 0 auto 28px; font-size: 16px; }

  .gh-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 36px;
    text-align: left;
  }
  .gh-tile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    transition: border-color .2s ease, transform .15s ease, box-shadow .2s ease;
  }
  .gh-tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 8px 24px rgba(0,0,0,0.07);
  }
  .gh-tile .glyph {
    width: 34px; height: 34px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }
  .gh-tile b {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    display: block;
    color: var(--text);
  }
  .gh-tile span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    word-break: break-word;
  }

  @media (max-width: 1024px) {
    .gh-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .gh-section { padding: 28px 22px; }
    .gh-grid { grid-template-columns: 1fr; }
  }
</style>
