---
import { getCollection } from 'astro:content';

const partners = (await getCollection('partners'))
  .sort((a, b) => (a.data.order - b.data.order) || a.data.name.localeCompare(b.data.name));
---
{partners.length > 0 && (
  <section class="section" id="partners">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">09 · Partners &amp; Collaborations</span>
        <h2>Built across NASA and partner organizations.</h2>
        <p>
          AKD is a collaborative effort spanning NASA programs, research labs, and
          engineering partners — connected through shared infrastructure and a
          commitment to open, trustworthy science tools.
        </p>
      </div>
      <ul class="partner-grid">
        {partners.map((p) => (
          <li class="partner">
            {p.data.url ? (
              <a href={p.data.url} target="_blank" rel="noopener">
                {p.data.logo
                  ? <img src={p.data.logo} alt={p.data.name} />
                  : <b>{p.data.name}</b>
                }
              </a>
            ) : (
              p.data.logo
                ? <img src={p.data.logo} alt={p.data.name} />
                : <b>{p.data.name}</b>
            )}
            {p.data.blurb && <span>{p.data.blurb}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .partner {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 22px 20px;
    background: rgba(255,255,255,0.02);
    transition: border-color .2s ease;
  }
  .partner:hover { border-color: var(--border-strong); }
  .partner b {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 16px;
    display: block;
    margin-bottom: 6px;
    color: var(--text);
  }
  .partner span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-top: 4px;
  }
  .partner a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .partner-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .partner-grid { grid-template-columns: 1fr; }
  }
</style>
