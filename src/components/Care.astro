---
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'care');
if (!entry) throw new Error('Missing pages/care content entry');
const baseUrl = import.meta.env.BASE_URL;

const roles = [
  {
    label: 'Subject Matter Experts',
    desc: 'Provide domain authority: surfacing nuanced constraints and validating scientific "truth".',
  },
  {
    label: 'Developers',
    desc: 'Act as the implementation authority, ensuring tool realism and feasibility.',
  },
  {
    label: 'Helper LLM Agents',
    desc: 'Serve as facilitation infrastructure: asking phase-aligned questions, drafting specifications in Markdown, and proposing revisions for human approval.',
  },
];

const phases = [
  {
    n: 1,
    label: 'Scope & Decompose',
    desc: 'Defines the target workflow, users, and constraints.',
  },
  {
    n: 2,
    label: 'Key Information Elicitation',
    desc: 'Captures details on tools, domain context, and required output formats.',
  },
  {
    n: 3,
    label: 'Reasoning Policy & Guardrails',
    desc: 'Codifies "expert-like" thinking logic and safety boundaries for uncertainty or tool errors.',
  },
  {
    n: 4,
    label: 'Implementation',
    desc: 'Translates approved artifacts into an engineered agent prompt using established design patterns.',
  },
  {
    n: 5,
    label: 'Benchmarking & Verification',
    desc: 'Establishes realistic query sets and scoring rubrics to detect regressions over time.',
  },
];
---
<section class="section care" id="care">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">03 · Methodology</span>
      <h2>{entry.data.title}</h2>
      <p>{entry.data.description}</p>
    </div>

    <ul class="care-roles">
      {roles.map((r) => (
        <li>
          <h3>{r.label}</h3>
          <p>{r.desc}</p>
        </li>
      ))}
    </ul>

    <p class="phases-eyebrow">Five phases: each gated by joint SME / developer / agent approval</p>
    <ol class="care-phases" aria-label="CARE methodology five phases">
      {phases.map((p) => (
        <li class="phase-step">
          <span class="phase-num">Phase {p.n}</span>
          <b>{p.label}</b>
          <p>{p.desc}</p>
        </li>
      ))}
    </ol>

    <a class="read-more" href={`${baseUrl}care/`}>
      Read the full methodology <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .care-roles {
    list-style: none;
    padding: 0;
    margin: 36px 0 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .care-roles li {
    padding: 22px 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.04);
  }
  .care-roles h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 17px;
    margin: 0 0 8px;
    color: var(--text);
  }
  .care-roles p {
    font-size: 14px;
    color: var(--text-dim);
    margin: 0;
    line-height: 1.55;
  }

  .phases-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }

  .care-phases {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    align-items: stretch;
  }
  .phase-step {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 18px 16px;
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .phase-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .phase-step b {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
    margin: 2px 0 4px;
    display: block;
    line-height: 1.25;
  }
  .phase-step p {
    font-size: 12.5px;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }
  .phase-step::after {
    content: "→";
    position: absolute;
    right: -10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 14px;
    font-family: var(--font-mono);
    z-index: 2;
    background: transparent;
  }
  .phase-step:last-child::after { content: ""; }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0);
    padding-bottom: 2px;
    transition: border-bottom-color 0.18s ease;
  }
  .read-more:hover {
    border-bottom-color: var(--accent);
  }

  @media (max-width: 1024px) {
    .care-roles { grid-template-columns: repeat(2, 1fr); }
    .care-phases { grid-template-columns: repeat(3, 1fr); }
    .phase-step::after { content: ""; }
  }
  @media (max-width: 720px) {
    .care-roles { grid-template-columns: 1fr; }
    .care-phases { grid-template-columns: 1fr; }
  }
</style>
