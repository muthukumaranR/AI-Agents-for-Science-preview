---
import { getCollection } from 'astro:content';

const items = (await getCollection('case-studies'))
  .sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));
---
{items.length > 0 && (
  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">09 · Real Science Applications</span>
        <h2>Agents in action.</h2>
        <p>
          End-to-end demonstrations of AKD agents supporting real scientific research
          workflows — from literature discovery and gap analysis through data search,
          code reuse, and publication-ready output.
        </p>
      </div>
      <div class="cs-grid">
        {items.map(async (item) => {
          const { Content } = await item.render();
          return (
            <article class="card cs-card">
              <h3>{item.data.title}</h3>
              <p class="cs-summary">{item.data.summary}</p>
              {item.data.designers.length > 0 && (
                <p class="cs-meta">
                  <span class="meta-label">Designers:</span>{' '}
                  {item.data.designers.join(', ')}
                </p>
              )}
              <div class="cs-body">
                <Content />
              </div>
              {item.data.repo && (
                <a class="cs-repo-link" href={item.data.repo} target="_blank" rel="noopener">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="14" height="14"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                  View on GitHub ↗
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cs-card h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    margin: 0;
  }

  .cs-summary {
    font-size: 15px;
    color: var(--accent);
    margin: 0;
    font-style: italic;
  }

  .cs-meta {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin: 0;
  }

  .meta-label {
    font-weight: 600;
    color: var(--text-dim);
  }

  .cs-body {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text);
  }

  .cs-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 500;
    margin: 18px 0 8px;
    color: var(--text);
  }

  .cs-body :global(p) {
    margin: 0 0 10px;
  }

  .cs-body :global(ul) {
    padding-left: 20px;
    margin: 0 0 10px;
  }

  .cs-body :global(li) {
    margin-bottom: 4px;
  }

  .cs-repo-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    border-top: 1px solid var(--border);
    padding-top: 14px;
    margin-top: auto;
    transition: color .2s ease;
  }

  .cs-repo-link:hover { color: var(--text); }
</style>
