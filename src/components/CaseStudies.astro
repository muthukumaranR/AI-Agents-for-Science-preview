---
import { getCollection } from 'astro:content';

const items = (await getCollection('case-studies'))
  .sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));

const baseUrl = import.meta.env.BASE_URL;
---
{items.length > 0 && (
  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">10 · Real Science Applications</span>
        <h2>Agents in action.</h2>
        <p>
          End-to-end demonstrations of AKD agents supporting real scientific research
          workflows — from literature discovery and gap analysis through data search,
          code reuse, and publication-ready output.
        </p>
      </div>
      <div class="cs-grid">
        {items.map((item) => (
          <article class="card cs-card">
            <h3>
              <a class="card-title-link" href={`${baseUrl}case-studies/${item.slug}`}>
                {item.data.title}
              </a>
            </h3>
            <p class="cs-summary">{item.data.summary}</p>
            {item.data.designers.length > 0 && (
              <p class="cs-meta">
                <span class="meta-label">Designers:</span>{' '}
                {item.data.designers.join(', ')}
              </p>
            )}
            <a class="cs-read-more" href={`${baseUrl}case-studies/${item.slug}`}>
              Read the case study <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 900px) {
    .cs-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cs-card h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    margin: 0;
  }
  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .card-title-link:hover { color: var(--accent); }

  .cs-summary {
    font-size: 15px;
    color: var(--text-dim);
    margin: 0;
    line-height: 1.55;
  }

  .cs-meta {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin: 0;
  }

  .meta-label {
    font-weight: 600;
    color: var(--text-dim);
  }

  .cs-read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0);
    padding-bottom: 2px;
    margin-top: auto;
    transition: border-bottom-color 0.18s ease;
    align-self: flex-start;
  }
  .cs-read-more:hover {
    border-bottom-color: var(--accent);
  }
</style>
