---
import { getCollection } from 'astro:content';

const paths = (await getCollection('pathways'))
  .sort((a, b) => a.data.order - b.data.order);

const pathData = Object.fromEntries(
  paths.map((p) => [p.data.slug, {
    title: p.data.title,
    steps: p.data.steps,
    services: p.data.services,
  }]),
);

const shortLabel = (eyebrow: string, startHere: boolean) => {
  if (startHere) return 'Start here';
  const parts = eyebrow.split('·').map((s) => s.trim());
  return parts[parts.length - 1];
};
---

<div class="pathway-strip" data-pathway-strip>
  <div class="strip-cards-row" role="group" aria-label="Featured pathway tours">
    {paths.map((p) => (
      <button
        type="button"
        class={`strip-card${p.data.startHere ? ' strip-card--start' : ''}`}
        data-path-slug={p.data.slug}
        aria-pressed="false"
        title={p.data.blurb}
      >
        <span class="strip-card__sub">{shortLabel(p.data.eyebrow, p.data.startHere)}</span>
        <b class="strip-card__title">{p.data.title}</b>
      </button>
    ))}
  </div>

</div>

<script type="application/json" id="pathway-data" is:inline set:html={JSON.stringify(pathData)}></script>

<style>
  .pathway-strip {
    position: sticky;
    top: 68px; /* sit just below the sticky site nav */
    z-index: 5;
    margin-top: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    backdrop-filter: saturate(180%) blur(6px);
    -webkit-backdrop-filter: saturate(180%) blur(6px);
  }

  /* ── Row 1: 7 cards spanning full strip width ──────────── */
  .strip-cards-row {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
    padding: 10px 14px;
  }

  .strip-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    font-family: inherit;
    min-width: 0;
    overflow: hidden;
  }
  .strip-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .strip-card[aria-pressed="true"] {
    border-color: var(--accent);
    background: oklch(0.97 0.018 262.881);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .strip-card__sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* allow wrap to 2 lines so 'Program manager' / 'Tool-independent' don't truncate */
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .strip-card__title {
    font-family: var(--font-serif);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .strip-card--start {
    border: 2px solid var(--accent);
    background: oklch(0.985 0.012 80);
  }
  .strip-card--start .strip-card__sub { color: var(--accent); }

  /* The cards row has no border-bottom on its own, so round the bottom of the
     sticky strip when the row sits flush against it. */
  .pathway-strip { border-radius: var(--radius-md); }
  .strip-cards-row { border-radius: 0 0 var(--radius-md) var(--radius-md); }

  /* Responsive */
  @media (max-width: 900px) {
    .strip-cards-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .strip-cards-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
