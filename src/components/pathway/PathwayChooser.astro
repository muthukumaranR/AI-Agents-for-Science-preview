---
import { getCollection } from 'astro:content';
import { PERSONAS, GOALS } from '../../content/pathway-graph';

const paths = (await getCollection('pathways'))
  .sort((a, b) => a.data.order - b.data.order);

const pathData = Object.fromEntries(
  paths.map((p) => [p.data.slug, {
    title: p.data.title,
    steps: p.data.steps,
    services: p.data.services,
  }]),
);
---

<div class="pathway-chooser">
  <div class="chooser-intro">
    <p>
      <b>What is this?</b> AKD — Accelerated Knowledge Discovery — is how we build, review, and publish AI agents for NASA science. Teams design each agent's behavior with subject-matter experts using a structured 5-phase process called <b>CARE</b> (Collaborative Agent Reasoning Engineering), build the agent in one of three forms — a simple chat prompt, a tool-using agent, or a multi-agent workflow — get it reviewed by a domain expert, and publish it for scientists to use.
    </p>
    <p>
      <b>What's below?</b> The pathway from idea to published agent. Pick a role and a goal to highlight your path, or click a featured tour. You don't need to know every product to read it — each step says what it is in plain English.
    </p>
  </div>

  <div class="chooser-controls">
    <label class="chooser-select">
      <span>I am a…</span>
      <select data-chooser-persona aria-label="Select your role">
        <option value="">— pick one —</option>
        {PERSONAS.map((p) => <option value={p.id}>{p.label}</option>)}
      </select>
    </label>
    <label class="chooser-select">
      <span>I want to…</span>
      <select data-chooser-goal aria-label="Select your goal">
        <option value="">— pick one —</option>
        {GOALS.map((g) => <option value={g.id}>{g.label}</option>)}
      </select>
    </label>
    <button type="button" class="chooser-clear" data-chooser-clear hidden>Clear ✕</button>
  </div>

  <div class="featured-paths">
    {paths.map((p) => (
      <button
        type="button"
        class={`featured-card${p.data.startHere ? ' featured-card--start' : ''}`}
        data-path-slug={p.data.slug}
        aria-pressed="false"
      >
        <span class="featured-eyebrow">{p.data.eyebrow}</span>
        <b class="featured-title">{p.data.title}</b>
        <span class="featured-blurb">{p.data.blurb}</span>
      </button>
    ))}
  </div>

  <div class="chooser-banner" data-chooser-banner hidden aria-live="polite">
    Showing: <b data-chooser-banner-title></b>
    <button type="button" class="banner-clear" data-chooser-clear>Clear ✕</button>
  </div>
</div>

<script type="application/json" id="pathway-data" is:inline set:html={JSON.stringify(pathData)}></script>

<style>
  .pathway-chooser { margin-top: 32px; display: flex; flex-direction: column; gap: 18px; }
  .chooser-intro p { font-family: var(--font-serif); font-size: 15px; line-height: 1.6; color: var(--text); margin: 0 0 10px; }
  .chooser-intro p:last-child { margin-bottom: 0; }

  .chooser-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 14px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .chooser-select { display: flex; flex-direction: column; gap: 4px; min-width: 220px; flex: 1; }
  .chooser-select span { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .chooser-select select { font-family: var(--font-sans); font-size: 14px; padding: 8px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-0); color: var(--text); }
  .chooser-clear { font-family: var(--font-mono); font-size: 11px; padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-0); color: var(--text); cursor: pointer; }

  .featured-paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .featured-card { text-align: left; display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-0); color: var(--text); cursor: pointer; transition: border-color 0.18s ease, transform 0.18s ease; font-family: inherit; }
  .featured-card:hover, .featured-card[aria-pressed="true"] { border-color: var(--accent); transform: translateY(-1px); }
  .featured-card[aria-pressed="true"] { box-shadow: 0 0 0 1px var(--accent) inset; }
  .featured-eyebrow { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .featured-title { font-family: var(--font-serif); font-size: 15px; }
  .featured-blurb { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; }
  .featured-card--start { border: 2px solid var(--accent); background: oklch(0.98 0.012 80); }
  .featured-card--start .featured-eyebrow { color: var(--accent); }

  .chooser-banner { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: oklch(0.97 0.005 262.881); border-left: 3px solid var(--accent); border-radius: 4px; font-size: 13px; }
  .chooser-banner[hidden] { display: none; }
  .banner-clear { margin-left: auto; font-family: var(--font-mono); font-size: 11px; padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-0); cursor: pointer; }

  @media (max-width: 900px) { .featured-paths { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .featured-paths { grid-template-columns: 1fr; } .chooser-controls { flex-direction: column; align-items: stretch; } }
</style>
