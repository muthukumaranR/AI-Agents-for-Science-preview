---
import { getCollection } from 'astro:content';
import { PERSONAS, GOALS } from '../../content/pathway-graph';

const paths = (await getCollection('pathways'))
  .sort((a, b) => a.data.order - b.data.order);

const pathData = Object.fromEntries(
  paths.map((p) => [p.data.slug, {
    title: p.data.title,
    steps: p.data.steps,
    services: p.data.services,
  }]),
);

const shortLabel = (eyebrow: string, startHere: boolean) => {
  if (startHere) return 'Start here';
  const parts = eyebrow.split('·').map((s) => s.trim());
  return parts[parts.length - 1];
};
---

<div class="pathway-strip" data-pathway-strip>
  <div class="strip-cards-row" role="group" aria-label="Featured pathway tours">
    {paths.map((p) => (
      <button
        type="button"
        class={`strip-card${p.data.startHere ? ' strip-card--start' : ''}`}
        data-path-slug={p.data.slug}
        aria-pressed="false"
        title={p.data.blurb}
      >
        <span class="strip-card__sub">{shortLabel(p.data.eyebrow, p.data.startHere)}</span>
        <b class="strip-card__title">{p.data.title}</b>
      </button>
    ))}
  </div>

  <div class="strip-aux-row">
    <span class="strip-aux__label">Or pick by</span>
    <label class="strip-select">
      <span>Role</span>
      <select data-chooser-persona aria-label="Select your role">
        <option value="">—</option>
        {PERSONAS.map((p) => <option value={p.id}>{p.label}</option>)}
      </select>
    </label>
    <label class="strip-select">
      <span>Goal</span>
      <select data-chooser-goal aria-label="Select your goal">
        <option value="">—</option>
        {GOALS.map((g) => <option value={g.id}>{g.label}</option>)}
      </select>
    </label>

    <div class="strip-banner" id="pathway-active-desc" data-chooser-banner hidden aria-live="polite">
      <span class="strip-banner__label">Showing</span>
      <b data-chooser-banner-title></b>
      <button type="button" class="strip-banner__clear" data-chooser-clear>Clear ✕</button>
    </div>
  </div>
</div>

<script type="application/json" id="pathway-data" is:inline set:html={JSON.stringify(pathData)}></script>

<style>
  .pathway-strip {
    position: sticky;
    top: 68px; /* sit just below the sticky site nav */
    z-index: 5;
    margin-top: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    backdrop-filter: saturate(180%) blur(6px);
    -webkit-backdrop-filter: saturate(180%) blur(6px);
  }

  /* ── Row 1: 7 cards spanning full strip width ──────────── */
  .strip-cards-row {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 8px;
    padding: 10px 14px;
  }

  .strip-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    font-family: inherit;
    min-width: 0;
    overflow: hidden;
  }
  .strip-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .strip-card[aria-pressed="true"] {
    border-color: var(--accent);
    background: oklch(0.97 0.018 262.881);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .strip-card__sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* allow wrap to 2 lines so 'Program manager' / 'Tool-independent' don't truncate */
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .strip-card__title {
    font-family: var(--font-serif);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .strip-card--start {
    border: 2px solid var(--accent);
    background: oklch(0.985 0.012 80);
  }
  .strip-card--start .strip-card__sub { color: var(--accent); }

  /* ── Row 2: persona/goal selects + banner ──────────────── */
  .strip-aux-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    flex-wrap: wrap;
  }
  .strip-aux__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .strip-select { display: flex; align-items: center; gap: 6px; }
  .strip-select span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .strip-select select {
    font-family: var(--font-sans);
    font-size: 12.5px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    color: var(--text);
    min-width: 130px;
  }

  /* Inline active banner (lives inside the aux row, pushed to the right) */
  .strip-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    padding: 4px 10px;
    background: var(--bg-0);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 13px;
  }
  .strip-banner[hidden] { display: none; }
  .strip-banner__label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .strip-banner b { font-family: var(--font-serif); font-weight: 500; }
  .strip-banner__clear {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    cursor: pointer;
    color: var(--text);
  }
  .strip-banner__clear:hover { border-color: var(--accent); color: var(--accent); }

  /* Responsive */
  @media (max-width: 900px) {
    .strip-cards-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .strip-aux-row { gap: 10px; }
    .strip-banner { margin-left: 0; flex-basis: 100%; }
  }
  @media (max-width: 560px) {
    .strip-cards-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .strip-aux-row { flex-direction: column; align-items: stretch; }
    .strip-select { flex-direction: column; align-items: flex-start; }
    .strip-select select { min-width: 0; width: 100%; }
  }
</style>
