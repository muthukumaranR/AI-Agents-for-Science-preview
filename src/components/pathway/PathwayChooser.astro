---
import { getCollection } from 'astro:content';
import { PERSONAS, GOALS } from '../../content/pathway-graph';

const paths = (await getCollection('pathways'))
  .sort((a, b) => a.data.order - b.data.order);

const pathData = Object.fromEntries(
  paths.map((p) => [p.data.slug, {
    title: p.data.title,
    steps: p.data.steps,
    services: p.data.services,
  }]),
);
---

<div class="pathway-chooser">
  <div class="chooser-section">
    <div class="chooser-eyebrow">Featured tours</div>
    <div class="featured-paths">
      {paths.map((p) => (
        <button
          type="button"
          class={`featured-card${p.data.startHere ? ' featured-card--start' : ''}`}
          data-path-slug={p.data.slug}
          aria-pressed="false"
        >
          <span class="featured-eyebrow">{p.data.eyebrow}</span>
          <b class="featured-title">{p.data.title}</b>
          <span class="featured-blurb">{p.data.blurb}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="chooser-divider"><span>or pick by role + goal</span></div>

  <div class="chooser-controls">
    <label class="chooser-select">
      <span>I am a…</span>
      <select data-chooser-persona aria-label="Select your role">
        <option value="">— pick one —</option>
        {PERSONAS.map((p) => <option value={p.id}>{p.label}</option>)}
      </select>
    </label>
    <label class="chooser-select">
      <span>I want to…</span>
      <select data-chooser-goal aria-label="Select your goal">
        <option value="">— pick one —</option>
        {GOALS.map((g) => <option value={g.id}>{g.label}</option>)}
      </select>
    </label>
  </div>

  <div class="chooser-banner" id="pathway-active-desc" data-chooser-banner hidden aria-live="polite">
    <div class="chooser-banner__head">
      <span class="chooser-banner__label">Showing</span>
      <b data-chooser-banner-title></b>
    </div>
    <button type="button" class="banner-clear" data-chooser-clear>Clear ✕</button>
  </div>
</div>

<script type="application/json" id="pathway-data" is:inline set:html={JSON.stringify(pathData)}></script>

<style>
  .pathway-chooser { display: flex; flex-direction: column; gap: 18px; }

  .chooser-section { display: flex; flex-direction: column; gap: 10px; }
  .chooser-eyebrow { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); }

  /* Featured cards: stacked single column inside narrow chooser; grid at wide stacked layout */
  .featured-paths { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .featured-card { text-align: left; display: flex; flex-direction: column; gap: 4px; padding: 11px 13px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-0); color: var(--text); cursor: pointer; transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; font-family: inherit; }
  .featured-card:hover, .featured-card[aria-pressed="true"] { border-color: var(--accent); }
  .featured-card[aria-pressed="true"] { box-shadow: 0 0 0 1px var(--accent) inset; background: oklch(0.985 0.008 262.881); }
  .featured-eyebrow { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .featured-title { font-family: var(--font-serif); font-size: 14px; line-height: 1.3; }
  .featured-blurb { font-size: 12px; color: var(--text-muted); line-height: 1.5; }
  .featured-card--start { border: 2px solid var(--accent); background: oklch(0.98 0.012 80); }
  .featured-card--start .featured-eyebrow { color: var(--accent); }

  .chooser-divider { display: flex; align-items: center; gap: 10px; }
  .chooser-divider::before, .chooser-divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }
  .chooser-divider span { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }

  .chooser-controls { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .chooser-select { display: flex; flex-direction: column; gap: 4px; }
  .chooser-select span { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .chooser-select select { font-family: var(--font-sans); font-size: 13.5px; padding: 7px 9px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-0); color: var(--text); }

  .chooser-banner { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: oklch(0.97 0.005 262.881); border-left: 3px solid var(--accent); border-radius: 4px; font-size: 13px; }
  .chooser-banner[hidden] { display: none; }
  .chooser-banner__head { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .chooser-banner__label { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); }
  .chooser-banner__head b { font-family: var(--font-serif); font-size: 14px; line-height: 1.3; color: var(--text); }
  .banner-clear { font-family: var(--font-mono); font-size: 10.5px; padding: 5px 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-0); cursor: pointer; color: var(--text); }
  .banner-clear:hover { border-color: var(--accent); color: var(--accent); }

  /* Stacked (mobile / <1200px) layout: cards in 2-3 columns to fill width */
  @media (max-width: 1199px) {
    .featured-paths { grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .featured-card { padding: 12px 14px; }
    .featured-title { font-size: 15px; }
    .featured-blurb { font-size: 12.5px; }
    .chooser-controls { flex-direction: row; flex-wrap: wrap; }
    .chooser-select { flex: 1; min-width: 220px; }
  }
  @media (max-width: 900px) { .featured-paths { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .featured-paths { grid-template-columns: 1fr; } .chooser-controls { flex-direction: column; align-items: stretch; } }
</style>
