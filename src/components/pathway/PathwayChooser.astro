---
import { getCollection } from 'astro:content';
import { PERSONAS, GOALS } from '../../content/pathway-graph';

const paths = (await getCollection('pathways'))
  .sort((a, b) => a.data.order - b.data.order);

const pathData = Object.fromEntries(
  paths.map((p) => [p.data.slug, {
    title: p.data.title,
    steps: p.data.steps,
    services: p.data.services,
  }]),
);

// Short labels for the compact strip — derived from `eyebrow` last segment so YAML stays the source of truth.
const shortLabel = (eyebrow: string, startHere: boolean) => {
  if (startHere) return 'Start here';
  const parts = eyebrow.split('·').map((s) => s.trim());
  return parts[parts.length - 1];
};
---

<div class="pathway-strip" data-pathway-strip>
  <div class="strip-main">
    <div class="strip-label">
      <span class="strip-label__eyebrow">Pick a tour</span>
      <span class="strip-label__hint">or use role + goal →</span>
    </div>

    <div class="strip-cards" role="group" aria-label="Featured pathway tours">
      {paths.map((p) => (
        <button
          type="button"
          class={`strip-card${p.data.startHere ? ' strip-card--start' : ''}`}
          data-path-slug={p.data.slug}
          aria-pressed="false"
          title={p.data.blurb}
        >
          <span class="strip-card__sub">{shortLabel(p.data.eyebrow, p.data.startHere)}</span>
          <b class="strip-card__title">{p.data.title}</b>
        </button>
      ))}
    </div>

    <div class="strip-controls">
      <label class="strip-select">
        <span>Role</span>
        <select data-chooser-persona aria-label="Select your role">
          <option value="">—</option>
          {PERSONAS.map((p) => <option value={p.id}>{p.label}</option>)}
        </select>
      </label>
      <label class="strip-select">
        <span>Goal</span>
        <select data-chooser-goal aria-label="Select your goal">
          <option value="">—</option>
          {GOALS.map((g) => <option value={g.id}>{g.label}</option>)}
        </select>
      </label>
    </div>
  </div>

  <div class="strip-banner" id="pathway-active-desc" data-chooser-banner hidden aria-live="polite">
    <span class="strip-banner__label">Showing</span>
    <b data-chooser-banner-title></b>
    <button type="button" class="strip-banner__clear" data-chooser-clear>Clear ✕</button>
  </div>
</div>

<script type="application/json" id="pathway-data" is:inline set:html={JSON.stringify(pathData)}></script>

<style>
  .pathway-strip {
    position: sticky;
    top: 68px; /* sit just below the sticky site nav */
    z-index: 5;
    margin-top: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-0);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    backdrop-filter: saturate(180%) blur(6px);
  }

  .strip-main {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    align-items: center;
    gap: 16px;
    padding: 10px 14px;
  }

  .strip-label { display: flex; flex-direction: column; gap: 2px; }
  .strip-label__eyebrow { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); }
  .strip-label__hint { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; color: var(--text-muted); opacity: 0.7; }

  /* Cards row */
  .strip-cards {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    min-width: 0;
  }

  .strip-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 7px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    font-family: inherit;
    min-width: 0;
    overflow: hidden;
  }
  .strip-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .strip-card[aria-pressed="true"] {
    border-color: var(--accent);
    background: oklch(0.97 0.018 262.881);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .strip-card__sub {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .strip-card__title {
    font-family: var(--font-serif);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .strip-card--start {
    border: 2px solid var(--accent);
    background: oklch(0.985 0.012 80);
  }
  .strip-card--start .strip-card__sub { color: var(--accent); }

  /* Compact selects on the right */
  .strip-controls { display: flex; gap: 8px; }
  .strip-select { display: flex; flex-direction: column; gap: 2px; }
  .strip-select span { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
  .strip-select select {
    font-family: var(--font-sans);
    font-size: 12.5px;
    padding: 5px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    color: var(--text);
    max-width: 130px;
  }

  /* Active banner row */
  .strip-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: oklch(0.97 0.005 262.881);
    border-top: 1px solid var(--border);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    font-size: 13px;
  }
  .strip-banner[hidden] { display: none; }
  .strip-banner__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .strip-banner b { font-family: var(--font-serif); font-weight: 500; }
  .strip-banner__clear {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    cursor: pointer;
    color: var(--text);
  }
  .strip-banner__clear:hover { border-color: var(--accent); color: var(--accent); }

  /* Responsive */
  @media (max-width: 1100px) {
    .strip-main { grid-template-columns: 1fr; gap: 10px; }
    .strip-label { flex-direction: row; gap: 8px; align-items: baseline; }
    .strip-controls { justify-content: flex-start; }
    .strip-select select { max-width: none; }
  }
  @media (max-width: 720px) {
    .strip-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .strip-card__title { font-size: 12px; }
  }
  @media (max-width: 480px) {
    .strip-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .strip-controls { flex-direction: column; }
  }
</style>
