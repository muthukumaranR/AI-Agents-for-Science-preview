---
import { STEPS, SERVICES, type Step } from '../../content/pathway-graph';

const stepsByRow = (row: Step['row']) => STEPS.filter((s) => s.row === row);

const designStep = stepsByRow('design')[0];
const designSub = stepsByRow('design-sub');
const pathA = designSub.find((s) => s.id === 'care-path-a')!;
const pathB = designSub.find((s) => s.id === 'care-path-b')!;
const outputStep = stepsByRow('output')[0];
const decisionStep = stepsByRow('decision')[0];
const branch1 = stepsByRow('branch-1');
const branch2 = stepsByRow('branch-2');
const branch3 = stepsByRow('branch-3');
const gateStep = stepsByRow('gate')[0];
const flowUiStep = stepsByRow('flow-ui')[0];
const endpoints = stepsByRow('endpoints');

const labsStep = branch2.find((s) => s.id === 'b2-labs')!;
const b2Initial = branch2.find((s) => s.id === 'b2-akdext')!;

const shortenLabel = (label: string) => {
  const parts = label.split(' · ');
  return parts.length > 1 ? parts.slice(1).join(' · ') : label;
};
---

<div class="pathway-pipeline" aria-label="Agent development pathway" aria-describedby="pathway-active-desc" data-pathway-diagram>

  <!-- Stage 1 · CARE Design Process -->
  <div class="pipeline-stage">
    <span class="pipeline-stage__label">Phase 1 · Design</span>
    <article class="pipe-card pipe-card--featured" data-step-id={designStep.id} role="group" aria-labelledby={`step-${designStep.id}-label`} title={designStep.description}>
      <span class="pipe-card__eyebrow">Step 1</span>
      <b id={`step-${designStep.id}-label`} class="pipe-card__title">{designStep.label}</b>
      <p class="pipe-card__sub">A 5-phase stage-gated process where SMEs, developers, and helper LLM agents specify what the agent should do.</p>
    </article>
  </div>

  <span class="pipeline-arrow pipeline-arrow--fork" aria-hidden="true">↦</span>

  <!-- Stage 2 · Two ways to run CARE (parallel lanes) -->
  <div class="pipeline-stage pipeline-stage--multi">
    <span class="pipeline-stage__label">Path A or B</span>
    <article class="pipe-card pipe-card--branch" data-step-id={pathA.id} role="group" aria-labelledby={`step-${pathA.id}-label`} title={pathA.description}>
      <span class="pipe-card__eyebrow">Path A</span>
      <b id={`step-${pathA.id}-label`} class="pipe-card__title">CARE Studio in AKD Labs UI</b>
    </article>
    <article class="pipe-card pipe-card--branch" data-step-id={pathB.id} role="group" aria-labelledby={`step-${pathB.id}-label`} title={pathB.description}>
      <span class="pipe-card__eyebrow">Path B</span>
      <b id={`step-${pathB.id}-label`} class="pipe-card__title">CARE phase prompts (ChatGPT / Claude)</b>
    </article>
  </div>

  <span class="pipeline-arrow pipeline-arrow--merge" aria-hidden="true">→</span>

  <!-- Stage 3 · CARE Output -->
  <div class="pipeline-stage">
    <span class="pipeline-stage__label">Artifacts</span>
    <article class="pipe-card" data-step-id={outputStep.id} role="group" aria-labelledby={`step-${outputStep.id}-label`} title={outputStep.description}>
      <span class="pipe-card__eyebrow">Step 2</span>
      <b id={`step-${outputStep.id}-label`} class="pipe-card__title">{outputStep.label}</b>
      <ul class="pipe-card__chips">
        <li>Prompt</li><li>Tools</li><li>Context</li><li>Guardrails</li>
      </ul>
    </article>
  </div>

  <span class="pipeline-arrow" aria-hidden="true">→</span>

  <!-- Stage 4 · Decision -->
  <div class="pipeline-stage">
    <span class="pipeline-stage__label">Choose</span>
    <article class="pipe-card pipe-card--decision" data-step-id={decisionStep.id} role="group" aria-labelledby={`step-${decisionStep.id}-label`} title={decisionStep.description}>
      <span class="pipe-card__eyebrow">Step 3</span>
      <b id={`step-${decisionStep.id}-label`} class="pipe-card__title">Choose Operationalization Path</b>
    </article>
  </div>

  <span class="pipeline-arrow pipeline-arrow--fork" aria-hidden="true">↦</span>

  <!-- Stage 5 · Branches (3 parallel lanes; Labs nested in B2) -->
  <div class="pipeline-stage pipeline-stage--multi pipeline-stage--branches">
    <span class="pipeline-stage__label">3 paths</span>
    <article class="pipe-card pipe-card--branch" data-step-id="b1-simple" role="group" aria-labelledby="step-b1-simple-label" title={branch1[0].description}>
      <span class="pipe-card__eyebrow">Branch 1 · Simple</span>
      <b id="step-b1-simple-label" class="pipe-card__title">{shortenLabel(branch1[0].label)}</b>
      {branch1[0].governance && <span class="gov-dot" title={branch1[0].governance}>●</span>}
    </article>
    <div class="branch-lane">
      <article class="pipe-card pipe-card--branch" data-step-id={b2Initial.id} role="group" aria-labelledby={`step-${b2Initial.id}-label`} title={b2Initial.description}>
        <span class="pipe-card__eyebrow">Branch 2 · Tool-enabled</span>
        <b id={`step-${b2Initial.id}-label`} class="pipe-card__title">{shortenLabel(b2Initial.label)}</b>
        {b2Initial.governance && <span class="gov-dot" title={b2Initial.governance}>●</span>}
      </article>
      <span class="lane-arrow" aria-hidden="true">↓</span>
      <article class="pipe-card pipe-card--branch pipe-card--sub" data-step-id={labsStep.id} role="group" aria-labelledby={`step-${labsStep.id}-label`} title={labsStep.description}>
        <span class="pipe-card__eyebrow">Iterate</span>
        <b id={`step-${labsStep.id}-label`} class="pipe-card__title">{labsStep.label}</b>
      </article>
    </div>
    <article class="pipe-card pipe-card--branch" data-step-id="b3-orch" role="group" aria-labelledby="step-b3-orch-label" title={branch3[0].description}>
      <span class="pipe-card__eyebrow">Branch 3 · Multi-agent</span>
      <b id="step-b3-orch-label" class="pipe-card__title">{shortenLabel(branch3[0].label)}</b>
      {branch3[0].governance && <span class="gov-dot" title={branch3[0].governance}>●</span>}
    </article>
  </div>

  <span class="pipeline-arrow" aria-hidden="true">→</span>

  <!-- Stage 6 · SME Gate -->
  <div class="pipeline-stage">
    <span class="pipeline-stage__label">Phase 4 · Gate</span>
    <article class="pipe-card pipe-card--gate" data-step-id={gateStep.id} role="group" aria-labelledby={`step-${gateStep.id}-label`} title={gateStep.description}>
      <span class="pipe-card__eyebrow">B2 + B3 · SME review</span>
      <b id={`step-${gateStep.id}-label`} class="pipe-card__title">SME Readiness Review (gate)</b>
      <span class="gov-dot gov-dot--strong" title={gateStep.governance}>●</span>
    </article>
  </div>

  <span class="pipeline-arrow" aria-hidden="true">→</span>

  <!-- Stage 7 · Flow UI -->
  <div class="pipeline-stage">
    <span class="pipeline-stage__label">Production</span>
    <article class="pipe-card pipe-card--featured" data-step-id={flowUiStep.id} role="group" aria-labelledby={`step-${flowUiStep.id}-label`} title={flowUiStep.description}>
      <span class="pipe-card__eyebrow">Step 5</span>
      <b id={`step-${flowUiStep.id}-label`} class="pipe-card__title">{flowUiStep.label}</b>
    </article>
  </div>

  <span class="pipeline-arrow pipeline-arrow--fork" aria-hidden="true">↦</span>

  <!-- Stage 8 · Endpoints -->
  <div class="pipeline-stage pipeline-stage--multi pipeline-stage--endpoints">
    <span class="pipeline-stage__label">Distribute</span>
    {endpoints.map((s) => (
      <article class="pipe-card pipe-card--endpoint" data-step-id={s.id} role="group" aria-labelledby={`step-${s.id}-label`} title={s.description}>
        <span class="pipe-card__eyebrow">Endpoint</span>
        <b id={`step-${s.id}-label`} class="pipe-card__title">{s.label}</b>
      </article>
    ))}
  </div>

</div>

<aside class="pathway-services" aria-label="AKD services available to teams">
  <div class="services-head">
    <span class="services-eyebrow">AKD services plug into the path above</span>
    <p>
      Governance and safety services come built in — available across every stage of the pathway. Highlighted services match the active tour; teams pick the rest as needed.
    </p>
  </div>
  <ul class="services-list">
    {SERVICES.map((svc) => (
      <li data-service-id={svc.id} title={svc.description}>
        <b>{svc.label}</b>
        <span>{svc.description}</span>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* ── Pipeline ──────────────────────────────────────────── */
  .pathway-pipeline {
    margin-top: 24px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;     /* cards align to top, no vertical stretch */
    gap: 6px;
    padding: 8px 4px 12px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
  }
  .pathway-pipeline::-webkit-scrollbar { height: 8px; }
  .pathway-pipeline::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .pipeline-stage {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 132px;
    min-width: 132px;
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  .pipeline-stage--multi { width: 158px; min-width: 158px; }
  .pipeline-stage--branches { width: 170px; min-width: 170px; }
  .pipeline-stage--endpoints { width: 152px; min-width: 152px; }

  .pipeline-stage__label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0 2px 2px;
    min-height: 14px;
  }

  .pipeline-arrow {
    align-self: flex-start;
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1;
    padding: 0;
    margin-top: 56px;   /* aligns roughly with first card's vertical midpoint (label + half card) */
  }
  .pipeline-arrow--fork,
  .pipeline-arrow--merge { color: var(--accent); font-size: 16px; }

  /* ── Cards ─────────────────────────────────────────────── */
  .pipe-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-0);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pipe-card:hover { border-color: var(--accent); cursor: help; }
  .pipe-card__eyebrow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pipe-card__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--text);
  }
  .pipe-card__sub {
    font-size: 10.5px;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 2px 0 0;
    font-style: italic;
  }
  .pipe-card--featured { border-color: var(--border-strong); }
  .pipe-card--featured::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.6;
  }
  .pipe-card--decision { background: oklch(0.985 0.005 262.881); }
  .pipe-card--gate { border-left: 3px solid var(--accent); }
  .pipe-card--branch { /* normal sizing */ }
  .pipe-card--sub { background: var(--surface); }
  .pipe-card--endpoint { border-color: var(--border-strong); }
  .pipe-card--endpoint .pipe-card__eyebrow { color: var(--accent); }

  /* Output chips */
  .pipe-card__chips { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .pipe-card__chips li {
    font-family: var(--font-mono);
    font-size: 9.5px;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--surface);
    color: var(--text);
  }

  /* Branch 2 lane wrapper (b2 + Labs nested) */
  .branch-lane { display: flex; flex-direction: column; gap: 4px; }
  .lane-arrow { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); text-align: center; line-height: 1; }

  /* Governance dot */
  .gov-dot {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 10px;
    color: var(--accent);
    line-height: 1;
  }
  .gov-dot--strong { font-size: 14px; }

  /* ── Highlight & dim states ────────────────────────────── */
  .pipe-card.active, .services-list li.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset, 0 4px 14px rgba(99, 102, 241, 0.10);
  }
  .pipe-card.dim, .services-list li.dim,
  .pipe-card.dim *, .services-list li.dim * {
    opacity: 0.32;
    filter: grayscale(0.3);
    transition: opacity 0.18s ease, filter 0.18s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .pipe-card.dim, .services-list li.dim,
    .pipe-card.dim *, .services-list li.dim * { transition: none; }
  }
  @media print {
    .pipe-card.dim, .services-list li.dim,
    .pipe-card.dim *, .services-list li.dim * {
      opacity: 1 !important;
      filter: none !important;
    }
    .pathway-pipeline { overflow: visible !important; flex-wrap: wrap; }
  }

  /* ── Services panel ────────────────────────────────────── */
  .pathway-services { margin-top: 32px; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px 24px 24px; background: var(--bg-0); box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04); }
  .services-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .services-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .services-head p { font-size: 13.5px; color: var(--text-dim); margin: 0; line-height: 1.55; }
  .services-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .services-list li { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
  .services-list b { font-family: var(--font-serif); font-weight: 500; font-size: 14px; color: var(--text); }
  .services-list span { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
  @media (max-width: 1024px) { .services-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .services-list { grid-template-columns: 1fr; } }
</style>
