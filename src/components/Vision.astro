---
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'vision');
if (!entry) throw new Error('Missing pages/vision content entry');
const baseUrl = import.meta.env.BASE_URL;
---
<section class="section" id="vision">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">01 · Vision</span>
      <h2>{entry.data.title}</h2>
      <p>{entry.data.description}</p>
    </div>
    <a class="read-more" href={`${baseUrl}vision/`}>
      Read the full vision <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0);
    padding-bottom: 2px;
    transition: border-bottom-color 0.18s ease;
  }
  .read-more:hover {
    border-bottom-color: var(--accent);
  }
</style>
