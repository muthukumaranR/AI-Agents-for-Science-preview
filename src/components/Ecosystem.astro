---
// Exported so integrations/akd-ref-validator.js (Task 8) can import and validate.
export const ECOSYSTEM_AKD_REFS = [
  { kind: 'frameworks' as const, path: 'frameworks' },
  { kind: 'flow' as const, path: 'flow' },
  { kind: 'labs' as const, path: 'labs' },
];
---
<section class="section" id="ecosystem">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">04 · Software Ecosystem</span>
      <h2>The AKD stack — from primitives to production.</h2>
      <p>
        A coherent set of open-source libraries and platforms supporting the full
        lifecycle: building primitives, extending with agent SDKs, benchmarking,
        publishing, and orchestrating agents into production-ready workflows.
      </p>
    </div>

    <div class="cards cards-3">
      <article class="card eco-card">
        <span class="tag">Library · Python</span>
        <h3>AKD Core</h3>
        <p>
          Core Python primitives for building AKD agents, tools, streaming workflows,
          human-in-the-loop pause points, planner registries, guardrail protocols, and
          LLM-agnostic provider support.
        </p>
        <a class="gh-link" href="https://github.com/NASA-IMPACT/akd-core" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          NASA-IMPACT/akd-core
        </a>
      </article>

      <article class="card eco-card">
        <span class="tag">Library · Extension Layer</span>
        <h3>AKD Ext</h3>
        <p>
          Opinionated extension layer with OpenAI Agents SDK integration, Pydantic
          Agents SDK support, MCP glue, automatic tool conversion, hosted MCP
          integration, file attachment support, and published domain agents.
        </p>
        <a class="gh-link" href="https://github.com/NASA-IMPACT/akd-ext" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          NASA-IMPACT/akd-ext
        </a>
      </article>

      <article class="card eco-card">
        <span class="tag">Platform · Production</span>
        <h3>AKD Flow</h3>
        <p>
          Production multi-agent workflow interface where users compose and run
          published agents through a planner and a visual workflow canvas — with
          explicit human approval gates.
        </p>
        <a class="gh-link" href="https://github.com/NASA-IMPACT/akd/tree/main/flow" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          NASA-IMPACT/akd · flow
        </a>
      </article>

      <article class="card eco-card">
        <span class="tag">Platform · Internal</span>
        <h3>AKD Labs</h3>
        <p>
          Internal development and benchmarking platform for creating, debugging,
          validating, and reviewing experimental agents before publication to
          AKD Flow.
        </p>
        <a class="gh-link" href="https://github.com/NASA-IMPACT/akd-labs" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          NASA-IMPACT/akd-labs
        </a>
      </article>

      <article class="card eco-card">
        <span class="tag">Library · Trust &amp; Safety</span>
        <h3>Guardrails</h3>
        <p>
          Reusable science-specific guardrails for checking inputs and outputs,
          detecting risks, and supporting trustworthy agent behavior across the
          ecosystem.
        </p>
        <a class="gh-link" href="https://github.com/NASA-IMPACT/akd/tree/main/guardrails" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          NASA-IMPACT/akd · guardrails
        </a>
      </article>

      <article class="card eco-card">
        <span class="tag">Pathway · Integrated</span>
        <h3>End-to-End Lifecycle</h3>
        <p>
          Each component is intentionally composable. Teams move from CARE design
          artifacts, through Labs benchmarking, into Flow publication — without
          rebuilding the agent runtime contract along the way.
        </p>
        <a class="gh-link" href="#pathway">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          See the development pathway
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 18px;
  }
  .cards-3 { grid-template-columns: repeat(3, 1fr); }

  .card {
    position: relative;
    padding: 28px 26px;
    background: linear-gradient(180deg, var(--surface), var(--bg-1));
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color .2s ease, transform .2s ease;
    overflow: hidden;
  }
  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(92,210,230,0.5), transparent);
    opacity: 0;
    transition: opacity .25s ease;
  }
  .card:hover::before { opacity: 1; }
  .card p { font-size: 14.5px; line-height: 1.6; }

  .eco-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .eco-card .tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .eco-card h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    margin: 0;
  }
  .eco-card p { font-size: 14.5px; margin: 0; flex: 1; }

  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    border-top: 1px solid var(--border);
    padding-top: 14px;
    transition: color .2s ease;
  }
  .gh-link:hover { color: var(--text); }
  .gh-link svg { width: 14px; height: 14px; }

  @media (max-width: 1024px) {
    .cards-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .cards-3 { grid-template-columns: 1fr; }
  }
</style>
