---
const baseUrl = import.meta.env.BASE_URL;
---
<header class="hero" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <!-- Floating mockflow decoration — adapted from ad-nextjs-ui landingPage.tsx -->
  <div class="mockflow-layer" aria-hidden="true">
    <img src={`${baseUrl}images/landing-mockflow2.png`} alt="" class="mf mf1" />
    <img src={`${baseUrl}images/landing-mockflow1.png`} alt="" class="mf mf2" />
    <img src={`${baseUrl}images/landing-mockflow3.png`} alt="" class="mf mf3" />
    <img src={`${baseUrl}images/landing-mockflow3.png`} alt="" class="mf mf4" />
  </div>
  <div class="container hero-inner">
    <div class="hero-cols">
      <div class="hero-headline">
        <span class="hero-tag"><span class="dot"></span>NASA IMPACT · Public Release</span>
        <h1>
          Accelerated Knowledge Discovery:<br/>
          <span class="accent">AI Agents for Science</span>
        </h1>
      </div>

      <div class="hero-body">
        <p class="lede">
          The <strong>AI Agents for Science</strong> initiative elevates AI from
          a limited tool into a comprehensive cognitive partner in scientific
          workflows. By helping scientists reclaim the 70–80% of the time they
          currently spend on manual, repetitive research tasks, agentic AI
          empowers researchers to redirect their focus toward high-level
          knowledge discovery and innovation.
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 56px 0 24px;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    z-index: 0;
  }
  .mockflow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .mf {
    position: absolute;
    width: 200px;
    opacity: 0.45;
  }
  .mf1 {
    top: 8%;
    left: -6%;
    animation: fade-in-scale 6s ease-in-out infinite;
  }
  .mf2 {
    bottom: -15%;
    left: 14%;
    animation: float 8s ease-in-out infinite 1s;
  }
  .mf3 {
    top: -12%;
    left: 52%;
    animation: float 7s ease-in-out infinite;
  }
  .mf4 {
    top: 42%;
    right: -6%;
    animation: float 5s ease-in-out infinite 0.6s;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--maxw);
  }

  /* Two-column grid: h1 gets more horizontal space than the lede */
  .hero-cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .hero-headline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-body {
    padding-top: 8px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--bg-0);
    margin-bottom: 20px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .hero-tag .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .hero h1 .accent {
    font-style: italic;
    color: var(--accent);
  }
  .hero p.lede {
    font-size: clamp(15px, 1.05vw, 16.5px);
    line-height: 1.6;
    color: var(--text-dim);
    margin: 0 0 14px;
  }
  .hero p.lede:last-of-type {
    margin-bottom: 0;
  }

  /* Stack to single column on narrow viewports */
  @media (max-width: 920px) {
    .hero-cols {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .hero-body {
      padding-top: 0;
    }
  }
</style>
