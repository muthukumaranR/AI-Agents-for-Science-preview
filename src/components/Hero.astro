---
// Hero is fully static — no props, no data-binding.
---
<header class="hero" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container hero-inner">
    <span class="hero-tag"><span class="dot"></span>NASA IMPACT · Public Release</span>

    <h1>
      AI Agents for Science:<br/>
      <span class="accent">Accelerated Knowledge Discovery</span>
    </h1>

    <p class="lede">
      A NASA IMPACT ecosystem for designing, building, validating, and deploying
      trustworthy AI agents for closed-loop scientific workflows — built around
      human-in-the-loop oversight, science guardrails, and open collaboration.
    </p>

    <div class="cta-row">
      <a class="btn btn-primary" href="https://github.com/NASA-IMPACT/AI-Agents-for-Science" target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        View GitHub Repository
      </a>
      <a class="btn btn-ghost" href="#agents">Explore Agents →</a>
      <a class="btn btn-ghost" href="#care">Learn CARE →</a>
    </div>

    <div class="hero-meta" role="list">
      <div role="listitem">
        <div class="k">Methodology</div>
        <div class="v">CARE</div>
      </div>
      <div role="listitem">
        <div class="k">Pattern</div>
        <div class="v">Closed-Loop</div>
      </div>
      <div role="listitem">
        <div class="k">Oversight</div>
        <div class="v">Human-in-the-Loop</div>
      </div>
      <div role="listitem">
        <div class="k">Posture</div>
        <div class="v">Open Science</div>
      </div>
    </div>

    <!-- Open Project Banner -->
    <aside class="open-banner" aria-label="Open project invitation">
      <span class="pill">Open Project</span>
      <p>
        Explore the AI Agents for Science repository, contribute agents, review
        documentation, and help build open, trustworthy AI infrastructure for science.
      </p>
      <a class="btn btn-primary" href="https://github.com/NASA-IMPACT/AI-Agents-for-Science" target="_blank" rel="noopener">Get Involved →</a>
    </aside>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 110px 0 90px;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: rgba(255,255,255,0.02);
    margin-bottom: 28px;
  }
  .hero-tag .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
  }
  .hero h1 .accent {
    font-style: italic;
    background: linear-gradient(120deg, var(--accent) 0%, var(--accent-2) 50%, var(--accent-4) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero p.lede {
    font-size: clamp(16px, 1.3vw, 19px);
    color: var(--text-dim);
    max-width: 720px;
    margin-bottom: 40px;
  }

  /* Stat strip under hero */
  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-top: 24px;
  }
  .hero-meta div {
    background: var(--bg-1);
    padding: 18px 22px;
  }
  .hero-meta .k {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .hero-meta .v {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--text);
  }

  /* Open Project banner */
  .open-banner {
    position: relative;
    z-index: 1;
    margin-top: 30px;
    padding: 28px 32px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(120deg, rgba(92,210,230,0.08), rgba(122,162,255,0.05) 50%, rgba(255,138,76,0.06));
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
  }
  .open-banner .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bg-0);
    background: var(--accent);
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 600;
  }
  .open-banner p { color: var(--text); margin: 0; font-size: 15.5px; }
  .open-banner :global(.btn) { white-space: nowrap; }

  @media (max-width: 1024px) {
    .hero-meta { grid-template-columns: repeat(2, 1fr); }
    .open-banner { grid-template-columns: 1fr; text-align: left; }
  }
  @media (max-width: 720px) {
    .hero-meta { grid-template-columns: 1fr; }
  }
</style>
