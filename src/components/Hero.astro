---
const baseUrl = import.meta.env.BASE_URL;
---
<header class="hero" id="top">
  <div class="hero-grid" aria-hidden="true"></div>
  <!-- Floating mockflow decoration — adapted from ad-nextjs-ui landingPage.tsx -->
  <div class="mockflow-layer" aria-hidden="true">
    <img src={`${baseUrl}images/landing-mockflow2.png`} alt="" class="mf mf1" />
    <img src={`${baseUrl}images/landing-mockflow1.png`} alt="" class="mf mf2" />
    <img src={`${baseUrl}images/landing-mockflow3.png`} alt="" class="mf mf3" />
    <img src={`${baseUrl}images/landing-mockflow3.png`} alt="" class="mf mf4" />
  </div>
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-tag"><span class="dot"></span>AI Agents for Science · NASA-IMPACT</span>
      <h1>
        How should we build<br/>
        <span class="accent">AI Agents for Science?</span>
      </h1>
      <p class="lede">
        We want to transform AI into a full cognitive research partner. The
        <strong>Accelerated Knowledge Discovery (AKD)</strong> project drives
        this transformation through five strategic pillars.
      </p>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="num">10</div>
          <div class="label">Published agents</div>
        </div>
        <div class="hero-stat">
          <div class="num">3</div>
          <div class="label">Workflows</div>
        </div>
        <div class="hero-stat">
          <div class="num">5</div>
          <div class="label">CARE phases</div>
        </div>
        <div class="hero-stat">
          <div class="num">8</div>
          <div class="label">Partner orgs</div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 72px 0 40px;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 30%, transparent 75%);
    z-index: 0;
  }
  .mockflow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .mf {
    position: absolute;
    width: 200px;
    opacity: 0.45;
  }
  .mf1 {
    top: 8%;
    left: -6%;
    animation: fade-in-scale 6s ease-in-out infinite;
  }
  .mf2 {
    bottom: -15%;
    left: 14%;
    animation: float 8s ease-in-out infinite 1s;
  }
  .mf3 {
    top: -12%;
    left: 52%;
    animation: float 7s ease-in-out infinite;
  }
  .mf4 {
    top: 42%;
    right: -6%;
    animation: float 5s ease-in-out infinite 0.6s;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--maxw);
  }

  .hero-content {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--bg-0);
    margin-bottom: 20px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .hero-tag .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(36px, 4.2vw, 60px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    text-wrap: balance;
  }
  .hero h1 .accent {
    font-style: italic;
    color: var(--accent);
  }
  .hero p.lede {
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
    max-width: 640px;
  }

  .hero-stats {
    align-self: stretch;
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--border);
  }
  .hero-stat .num {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    color: var(--text);
    line-height: 1;
  }
  .hero-stat .label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-top: 6px;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 48px 0 28px;
    }
    .hero-stats {
      gap: 28px;
      margin-top: 32px;
      padding-top: 20px;
    }
    .hero-stat .num { font-size: 24px; }
  }
</style>
