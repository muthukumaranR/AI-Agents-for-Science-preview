---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await study.render();
const baseUrl = import.meta.env.BASE_URL;
---
<Base
  title={`${study.data.title} · AI Agents for Science`}
  description={study.data.summary}
>
  <Nav />
  <main class="container detail-page">
    <a class="back-link" href={`${baseUrl}#case-studies`}>← Back to Real Science Applications</a>

    <header class="detail-hero">
      <span class="eyebrow">Case Study</span>
      <h1>{study.data.title}</h1>
      <p class="lede">{study.data.summary}</p>
      {study.data.designers.length > 0 && (
        <div class="attribution">
          <p><strong>Designers:</strong> {study.data.designers.join(', ')}</p>
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="detail-footer">
      {study.data.repo && (
        <a class="akd-ref" href={study.data.repo} target="_blank" rel="noopener">
          Repository ↗
        </a>
      )}
    </footer>
  </main>
  <Footer />
</Base>

<style>
  .detail-page {
    padding: 60px 0 80px;
    max-width: 800px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    transition: color 0.18s ease;
  }
  .back-link:hover { color: var(--accent); }

  .detail-hero { margin-bottom: 32px; }

  .detail-hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    margin: 12px 0 16px;
    color: var(--text);
  }

  .detail-hero .lede {
    font-size: 20px;
    color: var(--text-dim);
    margin: 0 0 24px;
    font-style: italic;
  }

  .attribution {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
  }
  .attribution p { margin: 0; color: var(--text-dim); }
  .attribution strong { color: var(--text); }

  .detail-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
</style>
