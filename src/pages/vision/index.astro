---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('pages', 'vision');
if (!entry) throw new Error('Missing pages/vision content entry');
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL;
---
<Base title={`${entry.data.title} · AI Agents for Science`} description={entry.data.description}>
  <main class="container detail-page">
    <a class="back-link" href={`${baseUrl}#vision`}>← Back home</a>
    <header class="detail-hero">
      <span class="eyebrow">Vision</span>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </main>
</Base>

<style>
  .detail-page { padding: 60px 0 80px; max-width: 800px; }
  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .back-link:hover { color: var(--accent); }
  .detail-hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    margin: 12px 0 16px;
    color: var(--text);
  }
  .detail-hero .lede {
    font-size: 20px;
    color: var(--text-dim);
    margin: 0 0 32px;
  }
</style>
